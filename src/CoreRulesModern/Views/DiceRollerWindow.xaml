<Window x:Class="CoreRulesModern.Views.DiceRollerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AD&amp;D Dice Roller — Beta" Width="1260" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WoodBrush}">
  <Window.Resources>
    <SolidColorBrush x:Key="FeltBrush" Color="#8A1515"/>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="28"/>
    </Style>
  </Window.Resources>
  <Grid Margin="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource ReaderFrameStyle}" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="DICE POOLS" FontFamily="ITC Korinna" FontWeight="Bold" FontSize="18" Margin="4,2,4,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
          <Button Style="{StaticResource SmallButton}" Content="+ New" Click="NewPool_Click"/>
          <Button Style="{StaticResource SmallButton}" Content="Duplicate" Click="DuplicatePool_Click"/>
          <Button Style="{StaticResource SmallButton}" Content="Delete" Click="DeletePool_Click"/>
        </StackPanel>
        <ListBox x:Name="PoolList" SelectionChanged="PoolList_SelectionChanged" Background="{DynamicResource ParchmentBrush}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#76552F" BorderThickness="1" CornerRadius="3" Padding="8" Margin="2">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" FontFamily="ITC Korinna" FontSize="15"/>
                  <TextBlock Text="{Binding CharacterName}" FontStyle="Italic"/>
                  <TextBlock Text="{Binding Summary}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource ReaderFrameStyle}" Padding="10">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8">
          <TextBlock x:Name="PoolTitle" Text="Attack" FontFamily="ITC Korinna" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="PoolSubtitle" FontStyle="Italic" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource FeltBrush}" CornerRadius="18" BorderBrush="#3A160E" BorderThickness="5" Padding="20">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="TrayPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </ScrollViewer>
        </Border>
        <TextBlock x:Name="ResultText" Grid.Row="2" Text="Select a pool and roll" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="ITC Korinna" FontSize="22" FontWeight="Bold" Margin="8" TextWrapping="Wrap"/>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Center">
          <Button Style="{StaticResource SmallButton}" Content="ROLL" FontSize="17" FontWeight="Bold" Padding="24,7" Click="Roll_Click"/>
          <Button Style="{StaticResource SmallButton}" Content="Add Die" Click="AddDie_Click"/>
          <Button Style="{StaticResource SmallButton}" Content="Copy Request" Click="CopyRequest_Click"/>
          <Button Style="{StaticResource SmallButton}" Content="Copy Result" Click="CopyResult_Click"/>
          <Button Style="{StaticResource SmallButton}" Content="History" Click="History_Click"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Border Grid.Column="4" Style="{StaticResource ReaderFrameStyle}" Padding="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="POOL DETAILS" FontFamily="ITC Korinna" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,10"/>
          <TextBlock Text="Name"/><TextBox x:Name="NameBox" TextChanged="PoolField_Changed" Margin="0,2,0,7"/>
          <TextBlock Text="PC / NPC"/><TextBox x:Name="CharacterBox" TextChanged="PoolField_Changed" Margin="0,2,0,7"/>
          <TextBlock Text="Pool type"/>
          <ComboBox x:Name="ModeBox" SelectionChanged="PoolField_Changed" Margin="0,2,0,10"><ComboBoxItem Content="Generic"/><ComboBoxItem Content="Attack"/><ComboBoxItem Content="Damage"/></ComboBox>
          <GroupBox x:Name="AttackOptions" Header="AD&amp;D Attack" Margin="0,2,0,10">
            <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="THAC0" VerticalAlignment="Center"/><TextBox x:Name="Thac0Box" Grid.Column="1" TextChanged="PoolField_Changed" Margin="3"/>
              <TextBlock Grid.Row="1" Text="Opponent AC" VerticalAlignment="Center"/><TextBox x:Name="AcBox" Grid.Row="1" Grid.Column="1" TextChanged="PoolField_Changed" Margin="3"/>
              <TextBlock Grid.Row="2" Text="Attack modifier" VerticalAlignment="Center"/><TextBox x:Name="AttackModifierBox" Grid.Row="2" Grid.Column="1" TextChanged="PoolField_Changed" Margin="3"/>
            </Grid>
          </GroupBox>
          <Separator Margin="0,3,0,8"/>
          <TextBlock Text="SELECTED DIE" FontFamily="ITC Korinna" FontWeight="Bold" FontSize="16"/>
          <TextBlock Text="Type" Margin="0,7,0,0"/>
          <ComboBox x:Name="DieTypeBox" SelectionChanged="DieField_Changed" Margin="0,2,0,7"><ComboBoxItem Content="d4" Tag="4"/><ComboBoxItem Content="d6" Tag="6"/><ComboBoxItem Content="d8" Tag="8"/><ComboBoxItem Content="d10" Tag="10"/><ComboBoxItem Content="d12" Tag="12"/><ComboBoxItem Content="d20" Tag="20"/><ComboBoxItem Content="d100" Tag="100"/></ComboBox>
          <TextBlock Text="Label / damage type"/><TextBox x:Name="DieLabelBox" TextChanged="DieField_Changed" Margin="0,2,0,7" ToolTip="Examples: Slashing, Fire, Goblin 2"/>
          <TextBlock Text="Modifier"/><TextBox x:Name="DieModifierBox" TextChanged="DieField_Changed" Margin="0,2,0,7"/>
          <TextBlock Text="Colour"/>
          <WrapPanel x:Name="ColourPanel" Margin="0,4,0,8"/>
          <Button Style="{StaticResource SmallButton}" Content="Remove Selected Die" Click="RemoveDie_Click"/>
          <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.8" Text="Tip: each die keeps its own colour and label, even inside the same pool. Click a die in the felt tray to edit it."/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
