<Window x:Class="CoreRulesModern.Views.DiceRollerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AD&amp;D Dice Roller — Illustrated Beta" Width="1440" Height="860" MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterOwner" Background="{DynamicResource WoodTextureBrush}">
 <Window.Resources>
  <ImageBrush x:Key="WoodTextureBrush" ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/WoodDark.png" TileMode="Tile" Viewport="0,0,420,420" ViewportUnits="Absolute"/>
  <ImageBrush x:Key="FeltBrush" ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/FeltRed.png" TileMode="Tile" Viewport="0,0,440,440" ViewportUnits="Absolute"/>
  <ImageBrush x:Key="ParchmentTextureBrush" ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/Parchment.png" TileMode="Tile" Viewport="0,0,430,430" ViewportUnits="Absolute"/>
  <ImageBrush x:Key="HeaderBrush" ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/PanelHeader9Slice.png" Stretch="Fill"/>
  <ImageBrush x:Key="RollButtonBrush" ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/RollButton9Slice.png" Stretch="Fill"/>
  <SolidColorBrush x:Key="FeltDarkBrush" Color="#351010"/><SolidColorBrush x:Key="InkBrush" Color="#2A2118"/><SolidColorBrush x:Key="GoldBrush" Color="#C99B3D"/>
  <DropShadowEffect x:Key="PanelShadow" Color="#180E08" BlurRadius="13" ShadowDepth="4" Opacity="0.55"/>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="ITC Korinna"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="#E7C98E"/><Setter Property="Background" Value="{StaticResource HeaderBrush}"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Padding" Value="18,7"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="30"/></Style>
  <Style x:Key="DieFaceButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="HitSurface" Background="Transparent" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HitSurface" Property="Background" Value="#25C99B3D"/><Setter Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HitSurface" Property="BorderBrush" Value="{StaticResource GoldBrush}"/><Setter TargetName="HitSurface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PoolItem" TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="#54FFFFFF" BorderBrush="#7A5A32" BorderThickness="1" CornerRadius="4" Padding="9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#F2DDAA"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource GoldBrush}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#CDE7D1A1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Style="{StaticResource ReaderFrameStyle}" Background="{StaticResource ParchmentTextureBrush}" Padding="10" Effect="{StaticResource PanelShadow}"><DockPanel>
   <TextBlock DockPanel.Dock="Top" Text="DICE POOLS" Style="{StaticResource SectionTitle}" FontSize="19"/><WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,8,0,0"><Button Style="{StaticResource SmallButton}" Content="+ New" Click="NewPool_Click"/><Button Style="{StaticResource SmallButton}" Content="Duplicate" Click="DuplicatePool_Click"/><Button Style="{StaticResource SmallButton}" Content="Delete" Click="DeletePool_Click"/></WrapPanel>
   <ListBox x:Name="PoolList" ItemContainerStyle="{StaticResource PoolItem}" SelectionChanged="PoolList_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource GoldBrush}" CornerRadius="3" Margin="0,1,7,1"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="Bold" FontFamily="ITC Korinna" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CharacterName}" FontStyle="Italic" Opacity="0.75" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Margin="0,4,0,0" FontWeight="SemiBold"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{StaticResource FeltDarkBrush}" CornerRadius="20" BorderBrush="#2E140E" BorderThickness="5" Padding="7" Effect="{StaticResource PanelShadow}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Padding="70,15"><Border.Background><ImageBrush ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/ParchmentTitlePlaque.png" Stretch="Fill"/></Border.Background><StackPanel><TextBlock x:Name="PoolTitle" Text="Attack" Foreground="#24170E" FontFamily="ITC Korinna" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="PoolSubtitle" Foreground="#4B3320" FontStyle="Italic" HorizontalAlignment="Center"/><TextBlock x:Name="PoolSummaryText" Foreground="#4B3320" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Border>
    <Grid Grid.Row="1" Margin="0,6"><Border Background="{StaticResource FeltBrush}" CornerRadius="24" Margin="30"/><Image Source="/CoreRulesLibrary;component/Assets/DiceRoller/TraySurround9Slice.png" Stretch="Fill" IsHitTestVisible="False"/><ScrollViewer Margin="64,55" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="TrayPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/></ScrollViewer></Grid>
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="6,3,6,8"><Button Content="ROLL" Click="Roll_Click" FontFamily="ITC Korinna" FontSize="22" FontWeight="Bold" Foreground="#F2D9A1" Background="{StaticResource RollButtonBrush}" BorderThickness="0" Padding="65,13" MinWidth="240" Cursor="Hand"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0"><Button Style="{StaticResource SmallButton}" Content="Copy Request" Click="CopyRequest_Click"/><Button Style="{StaticResource SmallButton}" Content="Copy Result" Click="CopyResult_Click"/></StackPanel></StackPanel>
   </Grid></Border>
   <Border Grid.Row="2" Style="{StaticResource ReaderFrameStyle}" Background="{StaticResource ParchmentTextureBrush}" Padding="10" Effect="{StaticResource PanelShadow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0"><TextBlock Text="ADD DIE" Style="{StaticResource SectionTitle}" FontSize="18" HorizontalAlignment="Center"/><WrapPanel x:Name="AddDiePanel" HorizontalAlignment="Center"/></StackPanel>
    <Border Grid.Column="2" BorderBrush="#9C742E" BorderThickness="1,0,0,0" Padding="12,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Text="SELECTED DIE" Style="{StaticResource SectionTitle}"/><Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Remove" Click="RemoveDie_Click"/></DockPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="Type" VerticalAlignment="Center"/><ComboBox x:Name="DieTypeBox" Grid.Column="1" SelectionChanged="DieField_Changed" Margin="2"><ComboBoxItem Content="d4" Tag="4"/><ComboBoxItem Content="d6" Tag="6"/><ComboBoxItem Content="d8" Tag="8"/><ComboBoxItem Content="d10" Tag="10"/><ComboBoxItem Content="d12" Tag="12"/><ComboBoxItem Content="d20" Tag="20"/><ComboBoxItem Content="d100" Tag="100"/></ComboBox>
      <TextBlock Grid.Row="1" Text="Modifier" VerticalAlignment="Center"/><TextBox x:Name="DieModifierBox" Grid.Row="1" Grid.Column="1" TextChanged="DieField_Changed" Margin="2"/>
      <TextBlock Grid.Row="2" Text="Label" VerticalAlignment="Center"/><TextBox x:Name="DieLabelBox" Grid.Row="2" Grid.Column="1" TextChanged="DieField_Changed" Margin="2"/>
      <TextBlock Grid.Row="3" Text="Colour" VerticalAlignment="Top" Margin="0,7,0,0"/><WrapPanel x:Name="ColourPanel" Grid.Row="3" Grid.Column="1" Margin="0,3,0,0"/>
     </Grid>
    </Grid></Border>
   </Grid></Border>
  </Grid>
  <Border Grid.Column="4" Style="{StaticResource ReaderFrameStyle}" Background="{StaticResource ParchmentTextureBrush}" Padding="11" Effect="{StaticResource PanelShadow}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0"><TextBlock Text="POOL DETAILS" Style="{StaticResource SectionTitle}" FontSize="18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Name" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1" TextChanged="PoolField_Changed" Margin="2"/><TextBlock Grid.Row="1" Text="PC / NPC" VerticalAlignment="Center"/><TextBox x:Name="CharacterBox" Grid.Row="1" Grid.Column="1" TextChanged="PoolField_Changed" Margin="2"/><TextBlock Grid.Row="2" Text="Pool type" VerticalAlignment="Center"/><ComboBox x:Name="ModeBox" Grid.Row="2" Grid.Column="1" SelectionChanged="PoolField_Changed" Margin="2"><ComboBoxItem Content="Generic"/><ComboBoxItem Content="Attack"/><ComboBoxItem Content="Damage"/></ComboBox></Grid>
    <GroupBox x:Name="AttackOptions" Header="AD&amp;D Attack" Margin="0,7,0,0"><Grid Margin="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="THAC0" VerticalAlignment="Center"/><TextBox x:Name="Thac0Box" Grid.Column="1" TextChanged="PoolField_Changed" Margin="2"/><TextBlock Grid.Row="1" Text="Opponent AC" VerticalAlignment="Center"/><TextBox x:Name="AcBox" Grid.Row="1" Grid.Column="1" TextChanged="PoolField_Changed" Margin="2"/><TextBlock Grid.Row="2" Text="Attack modifier" VerticalAlignment="Center"/><TextBox x:Name="AttackModifierBox" Grid.Row="2" Grid.Column="1" TextChanged="PoolField_Changed" Margin="2"/></Grid></GroupBox>
   </StackPanel>
   <Border Grid.Row="2" BorderBrush="#9C742E" BorderThickness="1" CornerRadius="5" Padding="13"><Border.Background><ImageBrush ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/ParchmentCard9Slice.png" Stretch="Fill"/></Border.Background><StackPanel><TextBlock Text="LAST ROLL" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="LastRollEquation" Text="No roll yet" FontFamily="ITC Korinna" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="LastRollOutcome" Margin="0,5,0,0" FontSize="17" FontWeight="Bold" Foreground="#7B1818" TextWrapping="Wrap"/><TextBlock x:Name="ResultText" Visibility="Collapsed"/></StackPanel></Border>
   <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ROLL HISTORY" Style="{StaticResource SectionTitle}"/><ListBox x:Name="RecentHistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" IsHitTestVisible="False" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#A98A5A" BorderThickness="0,0,0,1" Padding="2,6"><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5"/></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Style="{StaticResource SmallButton}" Content="History…" HorizontalAlignment="Right" Margin="0,8,0,0" Click="History_Click"/></Grid>
  </Grid></Border>
 </Grid>
</Window>
