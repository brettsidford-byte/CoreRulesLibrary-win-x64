<Window x:Class="CoreRulesModern.Views.DiceRollerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AD&amp;D Dice Roller — Illustrated Beta" Width="1536" Height="960" MinWidth="760" MinHeight="520" WindowState="Maximized"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WoodTextureBrush}">
 <Window.Resources>
  <ImageBrush x:Key="WoodTextureBrush" ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/WoodDark.png" TileMode="Tile" Viewport="0,0,430,430" ViewportUnits="Absolute"/>
  <ImageBrush x:Key="FeltBrush" ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/FeltRed.png" TileMode="Tile" Viewport="0,0,420,420" ViewportUnits="Absolute"/>
  <ImageBrush x:Key="ParchmentBrush" ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/Parchment.png" TileMode="Tile" Viewport="0,0,420,420" ViewportUnits="Absolute"/>
  <ImageBrush x:Key="HeaderBrush" ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/PanelHeaderCropped.png" Stretch="Fill"/>
  <ImageBrush x:Key="RollBrush" ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/RollButtonCropped.png" Stretch="Fill"/>
  <SolidColorBrush x:Key="Ink" Color="#24170E"/><SolidColorBrush x:Key="Gold" Color="#C99B3D"/><SolidColorBrush x:Key="DarkWood" Color="#28170F"/>
  <DropShadowEffect x:Key="PanelShadow" Color="#090504" BlurRadius="12" ShadowDepth="4" Opacity="0.75"/>

  <Style x:Key="PanelHeader" TargetType="TextBlock">
   <Setter Property="Background" Value="{StaticResource HeaderBrush}"/><Setter Property="Foreground" Value="#E7C98E"/>
   <Setter Property="FontFamily" Value="ITC Korinna"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="17"/>
   <Setter Property="TextAlignment" Value="Center"/><Setter Property="Padding" Value="18,8"/><Setter Property="Margin" Value="0,0,0,7"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#E8D4A6"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#604225"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6,4"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#E8D4A6"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#604225"/><Setter Property="Padding" Value="5,3"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="AntiqueButton" TargetType="Button">
   <Setter Property="Foreground" Value="#EBCF96"/><Setter Property="Background" Value="#3A2417"/><Setter Property="BorderBrush" Value="#9D732C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="ITC Korinna"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#E4B84F"/><Setter TargetName="Face" Property="Background" Value="#51331D"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DieFaceButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Hit" Background="Transparent" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#35C99B3D"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.62"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hit" Property="BorderBrush" Value="{StaticResource Gold}"/><Setter TargetName="Hit" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PoolItem" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="#DDE8D4A6" BorderBrush="#76542C" BorderThickness="1" CornerRadius="4" Padding="10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#F2DCA2"/><Setter TargetName="Card" Property="BorderBrush" Value="#D4A43B"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F0DEAE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <ScrollViewer x:Name="LayoutScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" Background="{DynamicResource WoodTextureBrush}">
 <Grid x:Name="ScaleRoot" Width="1500" Height="920" Margin="8" HorizontalAlignment="Center" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
  <!-- Dice pools -->
  <Border Grid.Column="0" Background="{StaticResource ParchmentBrush}" BorderBrush="#29170E" BorderThickness="4" Padding="8" Effect="{StaticResource PanelShadow}"><DockPanel>
   <TextBlock DockPanel.Dock="Top" Text="DICE POOLS" Style="{StaticResource PanelHeader}"/>
   <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,7,0,0"><Button Style="{StaticResource AntiqueButton}" Content="+ NEW POOL" Click="NewPool_Click"/><Button Style="{StaticResource AntiqueButton}" Content="DUPLICATE" Click="DuplicatePool_Click"/><Button Style="{StaticResource AntiqueButton}" Content="DELETE" Click="DeletePool_Click"/></WrapPanel>
   <ListBox x:Name="PoolList" ItemContainerStyle="{StaticResource PoolItem}" SelectionChanged="PoolList_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Ellipse Width="9" Height="9" Fill="{Binding ModeMarkerBrush}" Stroke="#382314" StrokeThickness="1" VerticalAlignment="Top" Margin="0,4,4,0"/>
     <StackPanel Grid.Column="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontFamily="ITC Korinna" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding Summary}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14"/></Grid><TextBlock Text="{Binding CharacterName}" Foreground="{Binding CharacterColourHex}" FontWeight="Bold" Margin="0,2,0,0"/><TextBlock Text="{Binding DetailLine}" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
    </Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel></Border>

  <!-- Centre -->
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="180"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#351011" BorderBrush="#24130C" BorderThickness="4" CornerRadius="7" Effect="{StaticResource PanelShadow}"><Grid><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><Image Source="/CoreRulesLibrary;component/Assets/DiceRoller/ParchmentTitlePlaqueCropped.png" Stretch="Fill" Width="490" HorizontalAlignment="Center" Margin="0,4"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PoolTitle" Text="ATTACK POOL" FontFamily="ITC Korinna" FontWeight="Bold" FontSize="24" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/><TextBlock x:Name="PoolSubtitle" FontFamily="ITC Korinna" FontSize="16" FontWeight="SemiBold" FontStyle="Italic" Foreground="#4A3220" HorizontalAlignment="Center"/><TextBlock x:Name="PoolSummaryText" Visibility="Collapsed"/></StackPanel></Grid>
    <Grid Grid.Row="1"><Border Background="{StaticResource FeltBrush}" CornerRadius="36" Margin="34"/><Image Source="/CoreRulesLibrary;component/Assets/DiceRoller/TraySurround9Slice.png" Stretch="Fill" IsHitTestVisible="False"/><ScrollViewer Margin="78,68" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="TrayPanel" HorizontalAlignment="Center" VerticalAlignment="Center"/></ScrollViewer></Grid>
    <Grid Grid.Row="2" Margin="18,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource AntiqueButton}" Content="COPY REQUEST" Click="CopyRequest_Click"/><Button Style="{StaticResource AntiqueButton}" Content="COPY RESULT" Click="CopyResult_Click"/></StackPanel>
     <Button Grid.Column="1" Content="ROLL" Click="Roll_Click" Background="{StaticResource RollBrush}" BorderThickness="0" Foreground="#F4DCA9" FontFamily="ITC Korinna" FontSize="23" FontWeight="Bold" Padding="60,13" Cursor="Hand"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="SCALE" Foreground="#D7BF91" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="ScaleBox" Width="105" SelectionChanged="ScaleBox_SelectionChanged"><ComboBoxItem Content="Automatic" Tag="Auto"/><ComboBoxItem Content="60%" Tag="0.6"/><ComboBoxItem Content="70%" Tag="0.7"/><ComboBoxItem Content="80%" Tag="0.8"/><ComboBoxItem Content="90%" Tag="0.9"/><ComboBoxItem Content="100%" Tag="1"/><ComboBoxItem Content="110%" Tag="1.1"/><ComboBoxItem Content="125%" Tag="1.25"/><ComboBoxItem Content="150%" Tag="1.5"/><ComboBoxItem Content="175%" Tag="1.75"/></ComboBox></StackPanel>
    </Grid>
   </Grid></Border>

   <!-- Expanded selected die editor and single add action -->
   <Border Grid.Row="2" Background="{StaticResource ParchmentBrush}" BorderBrush="#29170E" BorderThickness="4" Padding="9" Effect="{StaticResource PanelShadow}"><Grid>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="SELECTED DIE" Style="{StaticResource PanelHeader}" Padding="18,4"/></Grid>
     <Grid Grid.Row="1" Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="150"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Type / quantity" Style="{StaticResource FieldLabel}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="18"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><ComboBox x:Name="DieTypeBox" SelectionChanged="DieField_Changed" Margin="2"><ComboBoxItem Content="d4" Tag="4"/><ComboBoxItem Content="d6" Tag="6"/><ComboBoxItem Content="d8" Tag="8"/><ComboBoxItem Content="d10" Tag="10"/><ComboBoxItem Content="d12" Tag="12"/><ComboBoxItem Content="d20" Tag="20"/><ComboBoxItem Content="d100" Tag="100"/></ComboBox><TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBox x:Name="DieQuantityBox" Grid.Column="2" TextChanged="DieField_Changed" Margin="2" HorizontalContentAlignment="Center" ToolTip="Number of this die to roll"/></Grid>
      <TextBlock Grid.Column="2" Text="Label" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/><TextBox x:Name="DieLabelBox" Grid.Column="3" TextChanged="DieField_Changed" Margin="2"/>
      <TextBlock Grid.Row="1" Text="Roll modifier" Style="{StaticResource FieldLabel}"/><Grid Grid.Row="1" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Button Style="{StaticResource AntiqueButton}" Content="−" Padding="4" Click="DieModifierDown_Click"/><TextBox x:Name="DieModifierBox" Grid.Column="1" TextChanged="DieField_Changed" Margin="2" HorizontalContentAlignment="Center"/><Button Grid.Column="2" Style="{StaticResource AntiqueButton}" Content="+" Padding="4" Click="DieModifierUp_Click"/></Grid>
      <Grid x:Name="DieAttackOptions" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="THAC0" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/><TextBox x:Name="DieThac0Box" Grid.Column="1" TextChanged="DieField_Changed" Margin="2" HorizontalContentAlignment="Center"/></Grid>
      <Grid x:Name="DieAttackBonusOptions" Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="Attack bonus" Style="{StaticResource FieldLabel}"/><Grid Grid.Column="1" Height="32"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Button Style="{StaticResource AntiqueButton}" Content="−" Padding="4" Click="DieAttackBonusDown_Click"/><TextBox x:Name="DieAttackBonusBox" Grid.Column="1" TextChanged="DieField_Changed" Margin="2" HorizontalContentAlignment="Center"/><Button Grid.Column="2" Style="{StaticResource AntiqueButton}" Content="+" Padding="4" Click="DieAttackBonusUp_Click"/></Grid></Grid>
      <TextBlock Grid.Row="2" Grid.Column="2" Text="Colour" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/><WrapPanel x:Name="ColourPanel" Grid.Row="2" Grid.Column="3" Margin="2,2,92,2"/>
     </Grid>
     <Button Grid.Row="1" Style="{StaticResource AntiqueButton}" Content="REMOVE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="RemoveDie_Click" Margin="0,0,8,1" Padding="12,5"/>
    </Grid>
   </Grid></Border>
  </Grid>

  <!-- Details and results -->
  <Border Grid.Column="4" Background="{StaticResource ParchmentBrush}" BorderBrush="#29170E" BorderThickness="4" Padding="8" Effect="{StaticResource PanelShadow}"><Grid><Grid.RowDefinitions><RowDefinition Height="310"/><RowDefinition Height="8"/><RowDefinition Height="220"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="POOL DETAILS" Style="{StaticResource PanelHeader}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" Grid.Column="1" TextChanged="PoolField_Changed" Margin="2"/>
    <TextBlock Grid.Row="1" Text="PC / NPC" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CharacterBox" Grid.Row="1" Grid.Column="1" TextChanged="PoolField_Changed" Margin="2"/>
    <TextBlock Grid.Row="2" Text="Pool type" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ModeBox" Grid.Row="2" Grid.Column="1" SelectionChanged="PoolField_Changed" Margin="2"><ComboBoxItem Content="Generic"/><ComboBoxItem Content="Attack"/><ComboBoxItem Content="Damage"/></ComboBox>
    <TextBlock Grid.Row="3" Text="Name colour" Style="{StaticResource FieldLabel}"/><Grid Grid.Row="3" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><ComboBox x:Name="CharacterColourBox" SelectionChanged="PoolField_Changed" Margin="2"><ComboBoxItem Content="Ink" Tag="#24170E"/><ComboBoxItem Content="Red" Tag="#A72222"/><ComboBoxItem Content="Blue" Tag="#235DA8"/><ComboBoxItem Content="Green" Tag="#2C7A43"/><ComboBoxItem Content="Purple" Tag="#6D3B91"/><ComboBoxItem Content="Gold" Tag="#A56A00"/><ComboBoxItem Content="Teal" Tag="#168A91"/></ComboBox><Button Grid.Column="1" Content="MORE…" Style="{StaticResource AntiqueButton}" Padding="4" Click="NameColourPicker_Click" ToolTip="Open the full Windows colour chooser"/></Grid>
   </Grid><GroupBox x:Name="AttackOptions" Header="Attack target" Margin="0,8,0,0" Foreground="{StaticResource Ink}" BorderBrush="#8A632E"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><TextBlock Text="Opponent AC" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AcBox" Grid.Column="1" TextChanged="PoolField_Changed" Margin="2"/></Grid></GroupBox>
   <Button x:Name="AddDieButton" Content="+  ADD DIE" Click="AddDie_Click" Style="{StaticResource AntiqueButton}" HorizontalAlignment="Stretch" Margin="3,10,3,0" Padding="10,8" FontSize="15" ToolTip="Add another die to this pool"/>
   </StackPanel>
   <Border Grid.Row="2" BorderBrush="#8A632E" BorderThickness="1" Padding="12"><Border.Background><ImageBrush ImageSource="/CoreRulesLibrary;component/Assets/DiceRoller/ParchmentCard9Slice.png" Stretch="Fill"/></Border.Background><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="JUST ROLLED" Style="{StaticResource PanelHeader}"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="3"><StackPanel><TextBlock x:Name="LastRollEquation" Text="No roll yet" FontFamily="ITC Korinna" FontSize="27" FontWeight="Bold" Foreground="{StaticResource Ink}" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="LastRollOutcome" Margin="0,6,0,0" FontSize="18" FontWeight="Bold" Foreground="#6F1717" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="ResultText" Visibility="Collapsed"/></StackPanel></ScrollViewer></Grid></Border>
   <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ROLL HISTORY" Style="{StaticResource PanelHeader}"/><ListBox x:Name="RecentHistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" IsHitTestVisible="False" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#A27B43" BorderThickness="0,0,0,1" Padding="3,7"><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Ink}"/></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Style="{StaticResource AntiqueButton}" Content="FULL HISTORY…" HorizontalAlignment="Right" Margin="0,7,0,0" Click="History_Click"/></Grid>
  </Grid></Border>
 </Grid></ScrollViewer>
</Window>
