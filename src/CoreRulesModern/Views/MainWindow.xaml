<Window x:Class="CoreRulesModern.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Core Rules Library" Width="1280" Height="820"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource WoodBrush}" Padding="10,3"
            BorderBrush="#B28A4D" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Book library…" Click="SelectLibrary_Click" FontSize="11"
                  Height="22" MinHeight="0" Padding="7,0" Margin="2,0" />
          <Button Content="Character sheets…" Click="SelectCharacters_Click" FontSize="11"
                  Height="22" MinHeight="0" Padding="7,0" Margin="2,0" />
        </StackPanel>
        <TextBlock Text="CORE RULES LIBRARY" Foreground="White" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MinWidth="220" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource ParchmentBrush}" Padding="14">
        <DockPanel>
          <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="4,4,4,12" Padding="10,7"
                   ToolTip="Filter books, characters and spells" TextChanged="SearchBox_TextChanged" />
          <TreeView x:Name="NavigationTree" FontSize="15" FontFamily="ITC Korinna"
                    Background="Transparent" BorderThickness="0"
                    SelectedItemChanged="NavigationTree_SelectedItemChanged">
            <TreeViewItem x:Name="CharactersRoot" Header="Characters" IsExpanded="True" />
            <TreeViewItem x:Name="BooksRoot" Header="Books" IsExpanded="True" />
            <TreeViewItem x:Name="SpellsRoot" Header="Spells" IsExpanded="True" />
            <TreeViewItem x:Name="OnlineResourcesRoot" Header="Online Resources" IsExpanded="True" />
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#C9C4B8" />

      <Grid Grid.Column="2" Background="{StaticResource ParchmentBrush}">
        <StackPanel x:Name="WelcomePanel" Margin="40" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="Your AD&amp;D library" FontSize="34" FontWeight="SemiBold" />
          <TextBlock x:Name="WelcomeSummary" Margin="0,10,0,22" FontSize="17" TextWrapping="Wrap"
                     Text="Choose the Core Rules folder containing WebHelp, then choose a folder containing exported HTML character sheets." />
          <Border Background="{StaticResource PanelBrush}" Padding="20" CornerRadius="4">
            <StackPanel>
              <TextBlock Text="Book library" FontWeight="SemiBold" FontSize="17" />
              <TextBlock x:Name="LibraryPathText" Margin="0,3,0,14" TextWrapping="Wrap" FontFamily="Consolas" Text="Not selected" />
              <TextBlock Text="Character sheets" FontWeight="SemiBold" FontSize="17" />
              <TextBlock x:Name="CharacterPathText" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="Consolas" Text="Not selected" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Grid x:Name="DocumentPanel" Visibility="Collapsed" Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="28" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,8" ClipToBounds="True"
                Background="{StaticResource WoodBrush}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="12,8,12,5" VerticalAlignment="Center">
              <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Height" Value="20" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="Padding" Value="7,0" />
                  <Setter Property="Margin" Value="2,0" />
                </Style>
              </WrapPanel.Resources>
              <TextBlock Text="Scale" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFF3D4" />
              <ComboBox x:Name="ScaleBox" Width="72" Height="22" FontSize="11"
                        SelectionChanged="ScaleBox_SelectionChanged" Margin="0,0,8,0">
                <ComboBoxItem Content="100%" Tag="100" />
                <ComboBoxItem Content="125%" Tag="125" />
                <ComboBoxItem Content="150%" Tag="150" />
                <ComboBoxItem Content="175%" Tag="175" />
                <ComboBoxItem Content="200%" Tag="200" />
                <ComboBoxItem Content="225%" Tag="225" />
                <ComboBoxItem Content="250%" Tag="250" />
                <ComboBoxItem Content="275%" Tag="275" />
                <ComboBoxItem Content="300%" Tag="300" />
              </ComboBox>
              <Button Content="Back" Click="Back_Click" />
              <Button Content="Forward" Click="Forward_Click" />
              <Button x:Name="PreviousPageButton" Content="Previous page" Click="PreviousPage_Click"
                      ToolTip="Open the previous HTML page in this book" IsEnabled="False" />
              <Button x:Name="NextPageButton" Content="Next page" Click="NextPage_Click"
                      ToolTip="Open the next HTML page in this book" IsEnabled="False" />
              <Button Content="Start page" Click="StartPage_Click" />
              <Button Content="Open in browser…" Click="OpenDocument_Click" />
              <Button x:Name="BackgroundDiagnosticsButton" Content="Background diagnostics…"
                      Click="BackgroundDiagnostics_Click" Visibility="Collapsed"
                      ToolTip="Inspect the character-sheet background and copy a diagnostic report" />
            </WrapPanel>
            <StackPanel Grid.Row="1" Margin="12,0,12,8">
              <TextBlock x:Name="DocumentTitleText" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FFF3D4" />
              <TextBlock x:Name="DocumentPathText" Margin="0,2,0,0" FontSize="11" Foreground="#E1C99C"
                         FontFamily="Consolas" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#C9C4B8"
                        Cursor="SizeNS" ToolTip="Drag to resize the reader header" />
          <Border Grid.Row="2" BorderBrush="#8A693E" BorderThickness="1" Background="{StaticResource ParchmentBrush}">
            <Grid>
              <WebBrowser x:Name="LegacyDocumentBrowser" Visibility="Collapsed"
                          LoadCompleted="LegacyDocumentBrowser_LoadCompleted" />
              <wv2:WebView2 x:Name="DocumentBrowser" Visibility="Collapsed"
                            NavigationCompleted="DocumentBrowser_NavigationCompleted" />
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="SpellPanel" Visibility="Collapsed" Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,12" Background="{StaticResource WoodBrush}" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,8">
              <TextBlock Text="Scale" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFF3D4" />
              <ComboBox x:Name="SpellScaleBox" Width="82" SelectionChanged="ScaleBox_SelectionChanged" Margin="0,0,12,0">
                <ComboBoxItem Content="100%" Tag="100" />
                <ComboBoxItem Content="125%" Tag="125" />
                <ComboBoxItem Content="150%" Tag="150" />
                <ComboBoxItem Content="175%" Tag="175" />
                <ComboBoxItem Content="200%" Tag="200" />
                <ComboBoxItem Content="225%" Tag="225" />
                <ComboBoxItem Content="250%" Tag="250" />
                <ComboBoxItem Content="275%" Tag="275" />
                <ComboBoxItem Content="300%" Tag="300" />
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="12,8">
              <TextBlock x:Name="SpellTitleText" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FFF3D4" />
              <TextBlock x:Name="SpellSourceText" Margin="0,4,0,0" FontSize="12" Foreground="#E1C99C"
                         FontFamily="Consolas" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" BorderBrush="#8A693E" BorderThickness="1" Background="{StaticResource ParchmentBrush}">
            <wv2:WebView2 x:Name="SpellBrowser" />
          </Border>
        </Grid>

        <Grid x:Name="OnlinePanel" Visibility="Collapsed" Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Back" Click="OnlineBack_Click" />
              <Button Content="Forward" Click="OnlineForward_Click" />
              <Button Content="Start page" Click="OnlineStartPage_Click" />
              <Button Content="Open in browser…" Click="OnlineOpen_Click" />
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="OnlineTitleText" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="OnlineAddressText" Margin="0,4,0,0" FontSize="12" Foreground="#5B6268"
                         FontFamily="Consolas" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" BorderBrush="#C9C4B8" BorderThickness="1" Background="White">
            <wv2:WebView2 x:Name="OnlineBrowser" />
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <StatusBar Grid.Row="2">
      <StatusBarItem><TextBlock x:Name="FooterStatus" Text="Ready" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock Text="Read-only library viewer" /></StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
