<Window x:Class="CoreRulesModern.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Core Rules Library" Width="1280" Height="820"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PaneHeaderBrush}" Padding="12,5"
            BorderBrush="{StaticResource FrameBorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Book library…" Click="SelectLibrary_Click" FontSize="11"
                  Height="22" MinHeight="0" Padding="7,0" Margin="2,0" />
          <Button Content="Character sheets…" Click="SelectCharacters_Click" FontSize="11"
                  Height="22" MinHeight="0" Padding="7,0" Margin="2,0" />
          <Button Content="Settings…" Click="Settings_Click" FontSize="11"
                  Height="22" MinHeight="0" Padding="7,0" Margin="2,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="ApplicationTitlePrefixText" Text="AD&amp;" Foreground="#E65749" FontSize="18"
                     FontFamily="Friz Quadrata" FontWeight="Bold" />
          <TextBlock x:Name="ApplicationTitleSuffixText" Text="D Core Rules Library" Margin="-3,0,0,0"
                     Foreground="#E65749" FontSize="18" FontFamily="Friz Quadrata" FontWeight="Bold" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Background="{DynamicResource WoodBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MinWidth="220" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition x:Name="BookContentsColumn" Width="0" MinWidth="0" />
        <ColumnDefinition x:Name="BookContentsSplitterColumn" Width="0" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Margin="10,10,5,10" Padding="12"
              Style="{StaticResource ReaderFrameStyle}">
       <Border Style="{StaticResource InsetHighlightStyle}">
        <Border Style="{StaticResource InsetShadowStyle}">
        <DockPanel>
          <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="4,4,4,12" Padding="10,7"
                   ToolTip="Filter books, characters and spells" TextChanged="SearchBox_TextChanged" />
          <Expander DockPanel.Dock="Top" Header="Spell filters" Margin="4,0,4,12"
                    FontFamily="ITC Korinna" FontWeight="Bold">
            <Grid Margin="6,8,2,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Caster" VerticalAlignment="Center" Margin="0,0,6,6" />
              <ComboBox x:Name="SpellCasterFilterBox" Grid.Column="1" Margin="0,0,0,6"
                        SelectionChanged="SpellFilter_Changed" SelectedValuePath="Tag">
                <ComboBoxItem Content="All casters" Tag="All" />
                <ComboBoxItem Content="Wizard" Tag="Wizard" />
                <ComboBoxItem Content="Priest" Tag="Priest" />
              </ComboBox>
              <TextBlock Grid.Row="1" Text="Level" VerticalAlignment="Center" Margin="0,0,6,6" />
              <ComboBox x:Name="SpellLevelFilterBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                        SelectionChanged="SpellFilter_Changed" SelectedValuePath="Tag">
                <ComboBoxItem Content="All levels" Tag="-1" />
                <ComboBoxItem Content="Level 0" Tag="0" /><ComboBoxItem Content="Level 1" Tag="1" />
                <ComboBoxItem Content="Level 2" Tag="2" /><ComboBoxItem Content="Level 3" Tag="3" />
                <ComboBoxItem Content="Level 4" Tag="4" /><ComboBoxItem Content="Level 5" Tag="5" />
                <ComboBoxItem Content="Level 6" Tag="6" /><ComboBoxItem Content="Level 7" Tag="7" />
                <ComboBoxItem Content="Level 8" Tag="8" /><ComboBoxItem Content="Level 9" Tag="9" />
              </ComboBox>
              <TextBlock Grid.Row="2" Text="School/sphere" VerticalAlignment="Center" Margin="0,0,6,6" />
              <ComboBox x:Name="SpellSchoolSphereFilterBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                        SelectionChanged="SpellFilter_Changed" />
              <TextBlock Grid.Row="3" Text="Components" VerticalAlignment="Center" Margin="0,0,6,6" />
              <ComboBox x:Name="SpellComponentFilterBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"
                        SelectionChanged="SpellFilter_Changed" SelectedValuePath="Tag">
                <ComboBoxItem Content="All components" Tag="All" />
                <ComboBoxItem Content="Verbal (V)" Tag="V" />
                <ComboBoxItem Content="Somatic (S)" Tag="S" />
                <ComboBoxItem Content="Material (M)" Tag="M" />
              </ComboBox>
              <TextBlock Grid.Row="4" Text="Source" VerticalAlignment="Center" Margin="0,0,6,0" />
              <ComboBox x:Name="SpellSourceFilterBox" Grid.Row="4" Grid.Column="1"
                        SelectionChanged="SpellFilter_Changed" SelectedValuePath="Tag">
                <ComboBoxItem Content="All sources" Tag="All" />
                <ComboBoxItem Content="Core Rules" Tag="Core" />
                <ComboBoxItem Content="User database" Tag="User" />
              </ComboBox>
            </Grid>
          </Expander>
          <TreeView x:Name="NavigationTree" FontSize="15" FontFamily="./Assets/Fonts/#Friz Quadrata" FontWeight="Bold"
                    Background="Transparent" BorderThickness="0"
                    SelectedItemChanged="NavigationTree_SelectedItemChanged">
            <TreeViewItem x:Name="BookmarksRoot" Header="Bookmarks" IsExpanded="True" />
            <TreeViewItem x:Name="RecentPagesRoot" Header="Recent pages" IsExpanded="True" />
            <TreeViewItem x:Name="CharactersRoot" Header="Characters" IsExpanded="True" />
            <TreeViewItem x:Name="BooksRoot" Header="Books" IsExpanded="True" />
            <TreeViewItem x:Name="SpellsRoot" Header="Spells" IsExpanded="True" />
            <TreeViewItem x:Name="OnlineResourcesRoot" Header="Online Resources" IsExpanded="True" />
          </TreeView>
        </DockPanel>
        </Border>
       </Border>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                    Background="{StaticResource SplitterBrush}" />

      <Border x:Name="BookContentsPanel" Grid.Column="2" Visibility="Collapsed"
              Margin="5,10" Padding="4" Style="{StaticResource ReaderFrameStyle}">
       <Border Style="{StaticResource InsetHighlightStyle}">
        <Border Style="{StaticResource InsetShadowStyle}">
        <Grid Background="{DynamicResource ParchmentBrush}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Background="{StaticResource PaneHeaderBrush}" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Hide" Click="ToggleBookContents_Click"
                    FontSize="11" Height="22" MinHeight="0" Padding="7,0" Margin="5"
                    ToolTip="Collapse the book contents panel" />
            <Button x:Name="ContextBookmarkButton" DockPanel.Dock="Right" Content="Bookmark spell"
                    Click="ContextBookmark_Click" Visibility="Collapsed"
                    FontSize="11" Height="22" MinHeight="0" Padding="7,0" Margin="0,5,0,5"
                    ToolTip="Add or remove this spell from bookmarks" />
          </DockPanel>
          <Grid Grid.Row="1">
            <Grid x:Name="BookReferenceSplitGrid">
              <Grid.RowDefinitions>
                <RowDefinition x:Name="CoverViewerRow" Height="*" MinHeight="120" />
                <RowDefinition x:Name="ReferenceSplitterRow" Height="6" />
                <RowDefinition Height="*" MinHeight="120" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Border x:Name="ManualCoverSurface" Background="Black" Visibility="Collapsed">
                  <Image x:Name="ManualCoverImage" Stretch="Uniform" StretchDirection="Both"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <WebBrowser x:Name="LegacyCoverBrowser" Visibility="Collapsed"
                            Navigating="LegacyCoverBrowser_Navigating"
                            LoadCompleted="LegacyCoverBrowser_LoadCompleted" />
                <wv2:WebView2 x:Name="CoverBrowser" Visibility="Collapsed"
                              NavigationStarting="CoverBrowser_NavigationStarting"
                              NavigationCompleted="CoverBrowser_NavigationCompleted" />
              </Grid>
              <GridSplitter x:Name="ReferenceGridSplitter" Grid.Row="1" Height="6"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                            Background="{StaticResource SplitterBrush}" Cursor="SizeNS"
                            ToolTip="Drag to resize the cover and contents panes" />
              <Grid Grid.Row="2">
                <WebBrowser x:Name="LegacyContentsBrowser" Visibility="Collapsed"
                            Navigating="LegacyContentsBrowser_Navigating"
                            LoadCompleted="LegacyContentsBrowser_LoadCompleted" />
                <wv2:WebView2 x:Name="ContentsBrowser" Visibility="Collapsed"
                              NavigationStarting="ContentsBrowser_NavigationStarting"
                              NavigationCompleted="ContentsBrowser_NavigationCompleted" />
              </Grid>
            </Grid>
            <wv2:WebView2 x:Name="SpellContextBrowser" Visibility="Collapsed" />
          </Grid>
        </Grid>
        </Border>
       </Border>
      </Border>

      <GridSplitter x:Name="BookContentsSplitter" Grid.Column="3" Width="5"
                    Visibility="Collapsed" HorizontalAlignment="Stretch"
                    Background="{StaticResource SplitterBrush}" />

      <Border Grid.Column="4" Margin="5,10,10,10" Padding="4"
              Style="{StaticResource ReaderFrameStyle}" Background="{DynamicResource WoodBrush}">
      <Border Style="{StaticResource InsetHighlightStyle}">
       <Border Style="{StaticResource InsetShadowStyle}">
       <Grid Background="{DynamicResource WoodBrush}">
        <StackPanel x:Name="WelcomePanel" Margin="30" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="Your AD&amp;D library" FontSize="34" FontWeight="SemiBold" />
          <TextBlock x:Name="WelcomeSummary" Margin="0,10,0,22" FontSize="17" TextWrapping="Wrap"
                     Text="Choose the Core Rules folder containing WebHelp, then choose a folder containing exported HTML character sheets." />
          <Border Background="{StaticResource PanelBrush}" Padding="20" CornerRadius="4">
            <StackPanel>
              <TextBlock Text="Book library" FontWeight="SemiBold" FontSize="17" />
              <TextBlock x:Name="LibraryPathText" Margin="0,3,0,14" TextWrapping="Wrap" FontFamily="Consolas" Text="Not selected" />
              <TextBlock Text="Character sheets" FontWeight="SemiBold" FontSize="17" />
              <TextBlock x:Name="CharacterPathText" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="Consolas" Text="Not selected" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Grid x:Name="DocumentPanel" Visibility="Collapsed" Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0" ClipToBounds="True"
                Background="{StaticResource PaneHeaderBrush}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="4" VerticalAlignment="Center">
              <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Height" Value="20" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="Padding" Value="7,0" />
                  <Setter Property="Margin" Value="2,0" />
                </Style>
              </WrapPanel.Resources>
              <TextBlock Text="Scale" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFF3D4"
                         FontFamily="ITC Korinna" />
              <ComboBox x:Name="ScaleBox" Width="72" Height="22" FontSize="11"
                        SelectionChanged="ScaleBox_SelectionChanged" Margin="0,0,8,0">
                <ComboBoxItem Content="100%" Tag="100" />
                <ComboBoxItem Content="125%" Tag="125" />
                <ComboBoxItem Content="150%" Tag="150" />
                <ComboBoxItem Content="175%" Tag="175" />
                <ComboBoxItem Content="200%" Tag="200" />
                <ComboBoxItem Content="225%" Tag="225" />
                <ComboBoxItem Content="250%" Tag="250" />
                <ComboBoxItem Content="275%" Tag="275" />
                <ComboBoxItem Content="300%" Tag="300" />
              </ComboBox>
              <Button Content="Back" Click="Back_Click" />
              <Button Content="Forward" Click="Forward_Click" />
              <Button x:Name="PreviousPageButton" Content="Previous page" Click="PreviousPage_Click"
                      ToolTip="Open the previous HTML page in this book" IsEnabled="False" />
              <Button x:Name="NextPageButton" Content="Next page" Click="NextPage_Click"
                      ToolTip="Open the next HTML page in this book" IsEnabled="False" />
              <Button Content="Start page" Click="StartPage_Click" />
              <Button x:Name="ContentsToggleButton" Content="Show contents"
                      Click="ToggleBookContents_Click" Visibility="Collapsed"
                      ToolTip="Show or hide this book's table of contents" />
              <Button x:Name="BookmarkPageButton" Content="Bookmark page" Click="BookmarkPage_Click"
                      ToolTip="Add or remove the current page from bookmarks" />
              <Button Content="Open in browser…" Click="OpenDocument_Click" />
              <Button x:Name="CharacterPrintButton" Content="Print character sheet…"
                      Click="PrintCharacterSheet_Click" Visibility="Collapsed"
                      ToolTip="Choose the character-sheet layout and open print preview" />
            </WrapPanel>
            <WrapPanel Grid.Row="1" Margin="4,0,4,4" VerticalAlignment="Center">
              <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="Height" Value="20" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="Padding" Value="7,0" />
                  <Setter Property="Margin" Value="2,0" />
                </Style>
              </WrapPanel.Resources>
              <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#FFF3D4"
                         FontFamily="ITC Korinna" />
              <TextBox x:Name="FindTextBox" Width="160" Height="22" FontSize="12" Margin="2,0"
                       Padding="4,1" KeyDown="FindTextBox_KeyDown" TextChanged="FindTextBox_TextChanged"
                       ToolTip="Find text on the current page (Ctrl+F)" />
              <Button Content="Previous match" Click="FindPrevious_Click" />
              <Button Content="Next match" Click="FindNext_Click" />
              <TextBlock x:Name="FindStatusText" VerticalAlignment="Center" Margin="5,0,0,0"
                         Foreground="#E1C99C" FontSize="11" />
            </WrapPanel>
            <StackPanel Grid.Row="2" Margin="4,0,4,4">
              <TextBlock x:Name="DocumentTitleText" FontSize="20" FontFamily="ITC Korinna"
                         FontWeight="Bold" TextWrapping="Wrap" Foreground="#FFF3D4" />
              <TextBlock x:Name="DocumentPathText" Visibility="Collapsed" Margin="0,1,0,0" FontSize="10" Foreground="#E1C99C"
                         FontFamily="ITC Korinna" FontWeight="Bold" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource ParchmentBrush}">
            <Grid>
              <WebBrowser x:Name="LegacyDocumentBrowser" Visibility="Collapsed"
                          Navigating="LegacyDocumentBrowser_Navigating"
                          LoadCompleted="LegacyDocumentBrowser_LoadCompleted" />
              <wv2:WebView2 x:Name="DocumentBrowser" Visibility="Collapsed"
                            NavigationStarting="DocumentBrowser_NavigationStarting"
                            NavigationCompleted="DocumentBrowser_NavigationCompleted" />
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="SpellPanel" Visibility="Collapsed" Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,4" Background="{StaticResource PaneHeaderBrush}" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,8">
              <Button x:Name="SpellBookmarkButton" Content="Bookmark spell" Click="SpellBookmark_Click"
                      ToolTip="Add or remove this spell from bookmarks" />
              <TextBlock Text="Scale" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFF3D4"
                         FontFamily="ITC Korinna" />
              <ComboBox x:Name="SpellScaleBox" Width="82" SelectionChanged="ScaleBox_SelectionChanged" Margin="0,0,12,0">
                <ComboBoxItem Content="100%" Tag="100" />
                <ComboBoxItem Content="125%" Tag="125" />
                <ComboBoxItem Content="150%" Tag="150" />
                <ComboBoxItem Content="175%" Tag="175" />
                <ComboBoxItem Content="200%" Tag="200" />
                <ComboBoxItem Content="225%" Tag="225" />
                <ComboBoxItem Content="250%" Tag="250" />
                <ComboBoxItem Content="275%" Tag="275" />
                <ComboBoxItem Content="300%" Tag="300" />
              </ComboBox>
            </StackPanel>
            <StackPanel Margin="12,8">
              <TextBlock x:Name="SpellTitleText" FontSize="30" FontFamily="ITC Korinna"
                         FontWeight="Bold" TextWrapping="Wrap" Foreground="#FFF3D4" />
              <TextBlock x:Name="SpellSourceText" Margin="0,4,0,0" FontSize="12" Foreground="#E1C99C"
                         FontFamily="ITC Korinna" FontWeight="Bold" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Background="{DynamicResource ParchmentBrush}">
            <wv2:WebView2 x:Name="SpellBrowser" />
          </Border>
        </Grid>

        <Grid x:Name="OnlinePanel" Visibility="Collapsed" Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,4" Background="{StaticResource PaneHeaderBrush}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Back" Click="OnlineBack_Click" />
              <Button Content="Forward" Click="OnlineForward_Click" />
              <Button Content="Start page" Click="OnlineStartPage_Click" />
              <Button x:Name="OnlineBookmarkButton" Content="Bookmark page" Click="OnlineBookmark_Click"
                      ToolTip="Add or remove this Complete Compendium page from bookmarks" />
              <Button Content="Open in browser…" Click="OnlineOpen_Click" />
            </StackPanel>
            <StackPanel Margin="12,8">
              <TextBlock x:Name="OnlineTitleText" FontSize="30" FontFamily="ITC Korinna"
                         FontWeight="Bold" TextWrapping="Wrap" Foreground="#FFF3D4" />
              <TextBlock x:Name="OnlineAddressText" Margin="0,4,0,0" FontSize="12" Foreground="#E1C99C"
                         FontFamily="ITC Korinna" FontWeight="Bold" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Background="{DynamicResource ParchmentBrush}">
            <wv2:WebView2 x:Name="OnlineBrowser"
                          NavigationStarting="OnlineBrowser_NavigationStarting"
                          SourceChanged="OnlineBrowser_SourceChanged"
                          NavigationCompleted="OnlineBrowser_NavigationCompleted" />
          </Border>
        </Grid>
       </Grid>
       </Border>
      </Border>
      </Border>
      </Grid>

    <StatusBar Grid.Row="2">
      <StatusBarItem><TextBlock x:Name="FooterStatus" Text="Ready" /></StatusBarItem>
      <Separator />
      <StatusBarItem><TextBlock Text="Read-only library viewer" /></StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
