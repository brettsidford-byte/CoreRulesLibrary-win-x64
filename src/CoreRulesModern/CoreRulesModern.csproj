<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>CoreRulesLibrary</AssemblyName>
    <RootNamespace>CoreRulesModern</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\CoreRulesLibrary.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <Authors>Core Rules Modern contributors</Authors>
    <Description>Modern Windows viewer for Core Rules WebHelp books and exported HTML character sheets.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\DiceRoller\FeltRed.png;Assets\DiceRoller\PanelHeaderCropped.png;Assets\DiceRoller\Parchment.png;Assets\DiceRoller\ParchmentCard9Slice.png;Assets\DiceRoller\ParchmentTitlePlaqueCropped.png;Assets\DiceRoller\RollButtonCropped.png;Assets\DiceRoller\TraySurround9Slice.png;Assets\DiceRoller\WoodDark.png;Assets\DiceRoller\DieFace-*.png" />
    <Content Include="Assets\Fonts\*.otf;Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\CharacterSheetTabletop.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Assets\ParchmentTexture.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>
</Project>
